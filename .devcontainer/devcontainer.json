{
  "name": "PC-Free: EXE Runner",
  // GitHub's default Codespaces image. It ships with Docker already running.
  "image": "mcr.microsoft.com/devcontainers/universal:2",
  // Builds (first time only) and starts EXE Runner on every Codespace start.
  "postStartCommand": "bash exe-runner/codespaces-start.sh",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "EXE Runner",
      "onAutoForward": "notify"
    }
  }
}
